#!/bin/bash
#SBATCH --job-name=samtools
#SBATCH --cpus-per-task=4
#SBATCH --mail-type=ALL
#SBATCH --mail-user=jlamb@crimson.ua.edu
#SBATCH -N 1 #nodes
#SBATCH -o samtools_%j.o

cd /home/jlamb1/SRA_seqs/
source ~/.bashrc
source activate /home/jlamb1/bin/miniconda3/envs/samtools/
base=$1

samtools view -bS ${base}_mapped_reads.sam > ${base}_mapped_reads.bam
samtools sort ${base}_mapped_reads.bam -o sorted_${base}_mapped_reads.bam
samtools view -b -f 12 -F 256 sorted_${base}_mapped_reads.bam > ${base}_nuclear_reads.bam
exit




