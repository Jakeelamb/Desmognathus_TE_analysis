{"kind":"table","sheet":"Associations","address":"A1:H21","rows":21,"cols":8,"values":[[null,null,null,null,null,null,null,null],["Table 2. Comparative associations",null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null],["Response or comparison","Species","Statistic","Estimate","95% CI low","95% CI high","P","Lambda"],["Reproductive strategy and TE composition",34,"R²",0.2601016805953517,"n.a.","n.a.",0.00001,"n.a."],["Strategy adjusted for recorded body size",34,"R²",0.19904284290161434,"n.a.","n.a.",0.00001,"n.a."],["Shannon entropy versus estimated genome size",21,"Slope per pg/1C",-0.007557817096005305,-0.015233862804372453,0.00011822861236184326,0.05328164510348311,1],["Gini–Simpson index versus estimated genome size",21,"Slope per pg/1C",-0.003623494940657906,-0.00696416319658273,-0.00028282668473308134,0.03502101656908224,1],["Cell area versus estimated genome size",24,"Standardized slope",0.71666442,0.40830013,1.02502872,0.00008157,1e-7],["Nucleus area versus estimated genome size",24,"Standardized slope",0.41901841,0.01755494,0.82048187,0.04154379,1e-7],["Cell area versus nucleus area",24,"Standardized slope",0.57930128,0.21889785,0.93970471,0.00301277,1e-7],["Median LTR ratio versus estimated genome size",19,"Log–log slope",0.024196124321278045,-0.5608651711893331,0.6092574198318892,0.93148859408955,6.1971160237726395e-9],[null,null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null],["Composition tests use post hoc species-label permutations without phylogenetic adjustment. Regression rows use Pagel-lambda PGLS. Slopes have different scales, specified in the statistic column. Cellular and LTR intervals are t-based. Genome sizes are IOD-derived estimates; morphology describes selected large erythrocytes. Displayed measurement uncertainty is not propagated through these regressions. Both diversity indices summarize each species’ ten most abundant superfamilies. No multiplicity adjustment has been added in this run.",null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null],["Sources: composition test export; Figure 3 full-sample model export; S26 cellular PGLS; retained LTR PGLS export. Full source identifiers and coefficient scales accompany the downloadable CSV.",null,null,null,null,null,null,null]]}
